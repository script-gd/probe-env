[configuration]
entry_symbol = "gdextension_entry"
compatibility_minimum = "4.5"
reloadable = true

[libraries]
linux.debug.arm64 = "res://bin/libprobe.so"
linux.release.arm64 = "res://bin/libprobe.so"
macos.debug.arm64 = "res://bin/libprobe.dylib"
macos.release.arm64 = "res://bin/libprobe.dylib"
linux.debug.x86_64 = "res://bin/libprobe.so"
linux.release.x86_64 = "res://bin/libprobe.so"
