--- /dev/null
+++ b/freemarker/ext/beans/_BeanPropertyDescriptor.java
@@ -0,0 +1,35 @@
+/*
+ * Internal, java.desktop-free replacement for java.beans.PropertyDescriptor.
+ * Only the read side is ever used by FreeMarker's introspection.
+ */
+package freemarker.ext.beans;
+
+import java.lang.reflect.Method;
+
+final class _BeanPropertyDescriptor {
+    private final String name;
+    private final Method readMethod;
+    private final Method indexedReadMethod;
+
+    _BeanPropertyDescriptor(String name, Method readMethod, Method indexedReadMethod) {
+        this.name = name;
+        this.readMethod = readMethod;
+        this.indexedReadMethod = indexedReadMethod;
+    }
+
+    String getName() {
+        return name;
+    }
+
+    Method getReadMethod() {
+        return readMethod;
+    }
+
+    Method getIndexedReadMethod() {
+        return indexedReadMethod;
+    }
+
+    boolean isIndexed() {
+        return indexedReadMethod != null;
+    }
+}
